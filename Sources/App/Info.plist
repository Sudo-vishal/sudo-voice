<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>LSUIElement</key>
    <true/>
    <key>NSMicrophoneUsageDescription</key>
    <string>SudoVoice needs microphone access for live speech-to-text transcription. All processing happens locally on your Mac.</string>
    <key>CFBundleName</key>
    <string>SudoVoice</string>
    <key>CFBundleIdentifier</key>
    <string>com.sudovoice.app</string>
    <!-- SudoVoice cloud backend (sign-in, Pro licensing, transcript sync).
         Fill in when the SudoVoice Supabase project is created; until then the
         app runs offline-only. Dev builds can also use the SUPABASE_URL /
         SUPABASE_ANON_KEY environment variables instead.
    <key>SupabaseURL</key>
    <string>https://YOUR-PROJECT-REF.supabase.co</string>
    <key>SupabaseAnonKey</key>
    <string>YOUR-ANON-KEY</string>
    -->

    <key>CFBundleVersion</key>
    <string>2.6.0</string>
    <key>CFBundleShortVersionString</key>
    <string>2.6.0</string>
    <key>CFBundleIconFile</key>
    <string>AppIcon</string>
    <key>CFBundleIconName</key>
    <string>AppIcon</string>
</dict>
</plist>
