# SudoVoice backend — copy to .env and fill in. NEVER commit .env.
# Where each value comes from is spelled out in backend/README.md.

# Supabase project URL (Dashboard -> Project Settings -> API -> Project URL)
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# Supabase anon/public key — safe to ship inside the client apps (RLS protects data)
SUPABASE_ANON_KEY=

# Supabase service_role key — bypasses RLS; server/edge-function use ONLY, never ship in an app
SUPABASE_SERVICE_ROLE_KEY=

# Razorpay key id (Dashboard -> Account & Settings -> API Keys) — used client-side at checkout
RAZORPAY_KEY_ID=

# Razorpay key secret — server-side only (order/subscription creation)
RAZORPAY_KEY_SECRET=

# Razorpay webhook signing secret — the value YOU choose when creating the webhook in the dashboard
RAZORPAY_WEBHOOK_SECRET=
